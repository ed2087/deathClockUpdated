    <!-- head include -->
    <%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="../../CSS/deathClockQuestionsPage.css">
</head>
<body>    

    <!-- nav include -->
    <%- include('../includes/nav.ejs') %>
    
    <!-- header include -->
    <%- include('../includes/secHeader.ejs') %>


    <main id="main">
        
        <!-- title -->
        <div id="top_title_wrap">
            <h2 id="topTitle">
                Discover Your Estimated Lifespan
            </h2>
            <p id="article">
                Use the death clock to reveal your estimated lifespan. Answer all questions honestly to get accurate results, as our AI analyzes your data to provide precise predictions.
            </p>
        </div>
       

        <form id="healthForm">
            <!-- Basic Information Section -->
            <fieldset>
                <legend>Basic Information: Unearth Your Identity</legend>
                <div>
                    <label for="dob">💀 What is your date of birth?</label>
                    <input type="date" id="dob" name="dob" required>
                    <script>
                        const dateEle = document.getElementById("dob");
                        const currentDate = new Date().toISOString().split("T")[0];
                        dateEle.value = currentDate;
                    </script>
                </div>
                <div>
                    <label for="gender">💀 What is your gender?</label>
                    <input type="text" id="gender" name="gender" required placeholder="Your Gender">
                </div>
                <div>
                    <label for="country">💀 Which country do you live in?</label>
                    <input type="text" id="country" name="country" required placeholder="Your Country">
                </div>
            </fieldset>
        
            <!-- Health Information Section -->
            <fieldset>
                <legend>Health Information</legend>
                <div>
                    <label for="height">💀 What is your height? - Please specify if it's in feet/inches or centimeters.</label>
                    <input type="text" id="height" name="height" required placeholder="e.g., 5'7&quot; or 170 cm">
                </div>
                <div>
                    <label for="weight">💀 What is your weight? - Please specify if it's in pounds (lbs) or kilograms (kg).</label>
                    <input type="text" id="weight" name="weight" required placeholder="e.g., 150 lbs or 68 kg">
                </div>
                
                <div>
                    <label for="chronic">💀 Do you have any chronic conditions? Please list them.</label>
                    <input type="text" id="chronic" name="chronic" placeholder="List your chronic conditions">
                </div>
                <div>
                    <label for="cancer">💀 Have you ever been diagnosed with cancer? If yes, please provide details.</label>
                    <input type="text" id="cancer" name="cancer" placeholder="Cancer details">
                </div>
                <div>
                    <label for="bloodPressure">💀 What is your blood pressure status?</label>
                    <input type="text" id="bloodPressure" name="bloodPressure" required placeholder="Your Blood Pressure Status">
                </div>
                <div>
                    <label for="cholesterol">💀 What are your cholesterol levels?</label>
                    <input type="text" id="cholesterol" name="cholesterol" required placeholder="Your Cholesterol Levels">
                </div>
            </fieldset>
        
            <!-- Lifestyle Information Section -->
            <fieldset>
                <legend>Lifestyle Information</legend>
                <div>
                    <label for="smoke">💀 Do you smoke? If yes, describe your smoking habits.</label>
                    <input type="text" id="smoke" name="smoke" placeholder="Describe your smoking habits">
                </div>
                <div>
                    <label for="alcohol">💀 How often do you consume alcohol? Describe your consumption habits.</label>
                    <input type="text" id="alcohol" name="alcohol" placeholder="Describe your alcohol consumption habits">
                </div>
                <div>
                    <label for="diet">💀 Describe your typical diet, including how often you eat fruits and vegetables.</label>
                    <input type="text" id="diet" name="diet" placeholder="Describe your diet">
                </div>
                <div>
                    <label for="exercise">💀 Describe your exercise routine.</label>
                    <input type="text" id="exercise" name="exercise" placeholder="Describe your exercise routine">
                </div>
                <div>
                    <label for="sleep">💀 How many hours of sleep do you get per night?</label>
                    <input type="text" id="sleep" name="sleep" required placeholder="Hours of sleep per night">
                </div>
                <div>
                    <label for="stress">💀 How do you manage stress?</label>
                    <input type="text" id="stress" name="stress" placeholder="Describe your stress management techniques">
                </div>
                <div>
                    <label for="risks">💀 Do you take unnecessary risks? (e.g., extreme sports, reckless driving)</label>
                    <input type="text" id="risks" name="risks" placeholder="Describe any unnecessary risks you take">
                </div>
            </fieldset>
        
            <!-- Family History Section -->
            <fieldset>
                <legend>Family History</legend>
                <div>
                    <label for="stroke">💀 Has anyone in your family had a stroke or heart attack before the age of 60? Please provide details.</label>
                    <input type="text" id="stroke" name="stroke" placeholder="Describe any family history of stroke or heart attack">
                </div>
                <div>
                    <label for="hereditary">💀 Does your family have a history of any hereditary conditions? Please list them.</label>
                    <input type="text" id="hereditary" name="hereditary" placeholder="List hereditary conditions">
                </div>
            </fieldset>
        
            <!-- Medical History Section -->
            <fieldset>
                <legend>Medical History</legend>
                <div>
                    <label for="checkup">💀 When was your last medical checkup?</label>
                    <input type="text" id="checkup" name="checkup" placeholder="Last medical checkup date">
                </div>
                <div>
                    <label for="vaccinations">💀 Are you up-to-date with recommended vaccinations?</label>
                    <input type="text" id="vaccinations" name="vaccinations" placeholder="Describe your vaccination status">
                </div>
            </fieldset>
        
            <!-- Social and Occupational Information Section -->
            <fieldset>
                <legend>Social and Occupational Information</legend>
                <div>
                    <label for="social">💀 Describe your social interactions and how often you engage in social activities.</label>
                    <input type="text" id="social" name="social" placeholder="Describe your social interactions">
                </div>
                <div>
                    <label for="occupation">💀 What is your occupation and how stressful do you find it?</label>
                    <input type="text" id="occupation" name="occupation" placeholder="Describe your occupation and stress level">
                </div>
                <div>
                    <label for="workEnv">💀 Describe your work environment (e.g., office, fieldwork, exposure to hazardous materials).</label>
                    <input type="text" id="workEnv" name="workEnv" placeholder="Describe your work environment">
                </div>
            </fieldset>
        
            <!-- Scenario Questions Section -->
            <fieldset>
                <legend>Scenario Questions: Test Your Survival Skills</legend>
                <div>
                    <label for="scenario1">💀 You are lost in a forest and night is falling. What is the first thing you do?</label>
                    <input type="text" id="scenario1" name="scenario1" placeholder="Describe your actions">
                </div>
                <div>
                    <label for="scenario2">💀 You find yourself in a burning building. What is your immediate response?</label>
                    <input type="text" id="scenario2" name="scenario2" placeholder="Describe your immediate response">
                </div>
                <div>
                    <label for="scenario3">💀 You encounter a wild animal on a hiking trip. What steps do you take to ensure your safety?</label>
                    <input type="text" id="scenario3" name="scenario3" placeholder="Describe your steps">
                </div>
            </fieldset>

            <!-- Do you want me to be brutaly hones or suger coted -->
            <fieldset>
                <legend>Warning! Brutal Honesty Ahead</legend>
                <div style="display: none;">
                    <label for="honesty">💀 How do you want the results?</label>
                    <input type="text" id="honesty" name="establishGPTHonestyLevel" required placeholder="Brutally Honest or Sugar-Coated">
                </div>
                <div>
                    <label class="explanation">
                        💀 Warning: This content may not be suitable for everyone. The AI will provide brutally honest answers, which some people may find disturbing. If you are easily scared or sensitive, please do not proceed.
                    </label>                    
                </div>
                <!-- legal stuff -->
                <div>
                    <label class="warning">
                        By clicking "I Am Ready," 💀 you agree to our <a href="/termsConditions" target="_blank">Terms and Conditions</a> and our <a href="/disclaimer">Disclaimer</a>
                    </label>
                </div>
            </fieldset>
        
            <input type="hidden" id="csrf" name="_csrf" value="<%= csrfToken %>">
            <button id="submit_btn" class="call_to_action_red">I Am Ready</button>
        </form>
        

    </main>

    <!-- footer include -->
    <%- include('../includes/footer.ejs') %>

    <!-- script -->
    <script src="../../../JS/master.js"></script>
    <script src="../../../JS/deathClockQuestions.js"></script>  
</body>
</html>