    <!-- head include -->
    <%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="../../CSS/submissionPage.css">  

</head>
<body>


    <!-- nav include -->
    <%- include('../includes/nav.ejs') %>

    <!-- header include -->
    <%- include('../includes/secHeader.ejs') %>

    <div id="submisson_form_wrap">

            <!-- add tile -->
            <div id="subm_title_wrap">
                <h2>SHARE YOUR CHILLING TALE</h2>
                <p>
                    Unleash your creativity and share your chilling tale with us! Whether it's a horror masterpiece, a captivating Creepypasta, or a short story that sends shivers down the spine, we welcome stories from all skill levels. Whether you're a seasoned writer or a novice storyteller, everyone is encouraged to publish their tales of terror. Your unique perspective adds to the diverse tapestry of horror stories on our platform. Embrace the darkness and let your imagination run wild!
                </p>
            </div>
            

            <!-- important message -->
            <div id="important_message">
                <h3 style="font-size: 2rem; color: red;">
                    Prohibited Content
                </h3>

                <ul>

                    <li>Targets or exploits children in any way.</li> 

                    <li>Violates any applicable laws or regulations.</li>

                    <li>Contains hate speech, threats, or defamation against a person or group.</li>

                    <li>Reveals private or personal information about someone without consent.</li>

                    <li>Impersonates someone in a misleading or deceptive manner.</li>

                    <li>Engages in unauthorized copying, plagiarism, or any illegal use of others' work.</li>

                </ul>

                <br>

                <p><strong class="special_red_text">Important Note:</strong> Any User Content that is deemed to be in violation of these guidelines will be removed from the site and the user will be banned from submitting further content. Users found in violation of these terms may be subject to account suspension or termination.</p>

                <br>

                <p>
                    <strong class="special_red_text">Important Note:</strong> If you are under 18, do NOT submit stories here. Instead, email your story and parent/guardian contact info to: <a class="link_styles" href="mailto:help.terrorhub@gmail.com">help.terrorhub@gmail.com</a>

                    As a minor, you cannot enter into a publishing contract. If we are interested in your story, we will contact your parent/guardian for consent and release forms.
                    
                    Any under 18 submissions through this form will be automatically rejected. Parental supervision is advised.
                </p>

            </div>

            <!-- action="/terrorTales/submission" method="POST" -->
            <form id="submission_form" onsubmit="sendData(event)">
                
                
                <% if(!legalName){ %>
                    <!-- check if user allready submide legal name -->
                    <div class="form_group" id="legalNameGroup">
                        <label for="legalName">Legal Name (Will not be shared with the public)*</label>
                        <input type="text" id="legalName" name="legalName" required placeholder="Enter Full Legal Name">
                        <p class="input_info">
                            To submit your story, we require your full legal name. By doing so, you agree to our terms and conditions, granting us permission to publish your story on our site. Don't worry, your full legal name will be treated with the utmost confidentiality and will not be disclosed publicly. Providing your full name also helps us in case we need to contact you regarding your story and ensures that proper credit is given where it's due.
                        </p>
                    </div>     
                <% }else{ %>  
                    <input type="hidden" id="legalName" name="legalName" required value="<%= legalName !== null ? legalName : '' %>">
                <% } %>

                <!-- choose language story will be written -->
                <div class="form_group" id="languageGroup">
                    <label for="language">Language*</label>
                    <p class="input_info">
                        Please choose the language in which your story is written. If your preferred language isn't listed, please contact the admin to request its addition to the options.
                    </p>
                    <select id="language" name="language">
                        <option value="English">English</option>
                        <option value="Spanish">Spanish</option>
                        <option value="Mandarin Chinese">Mandarin Chinese</option>
                        <option value="Hindi">Hindi</option>
                        <option value="Arabic">Arabic</option>
                        <option value="Bengali">Bengali</option>
                        <option value="Portuguese">Portuguese</option>
                        <option value="Russian">Russian</option>
                        <option value="Japanese">Japanese</option>
                        <option value="Punjabi">Punjabi</option>
                        <option value="German">German</option>
                        <option value="Wu Chinese">Wu Chinese</option>
                        <option value="Javanese">Javanese</option>
                        <option value="Korean">Korean</option>
                        <option value="French">French</option>
                        <option value="Telugu">Telugu</option>
                        <option value="Marathi">Marathi</option>
                        <option value="Tamil">Tamil</option>
                        <option value="Turkish">Turkish</option>
                        <option value="Vietnamese">Vietnamese</option>
                    </select>                    
                </div>                
                
                <div class="form_group" id="socialMediaGroup">
                    <label for="socialMedia">Social Media Links</label>
                    <p class="input_info">
                        Please enter the URLs of any social media accounts you'd like to share with our readers. If you don't have any social media accounts, you can leave this field blank.
                    </p>
                    <div class="inner_formGroup">
                        <input type="text" id="facebookInput" name="socialMedia" placeholder="Facebook">
                        <input type="text" id="twitterInput" name="socialMedia" placeholder="Twitter">
                        <input type="text" id="instagramInput" name="socialMedia" placeholder="Instagram">
                        <input type="text" id="linkedinInput" name="socialMedia" placeholder="LinkedIn">
                        <input type="text" id="pinterestInput" name="socialMedia" placeholder="Pinterest">
                        <input type="text" id="youtubeInput" name="socialMedia" placeholder="YouTube Channel">
                        <input type="text" id="tiktokInput" name="socialMedia" placeholder="TikTok">
                        <input type="text" id="redditInput" name="socialMedia" placeholder="Reddit">
                    </div>                    
                </div>

                <div class="form_group" id="websiteGroup">
                    <label for="website">Website</label>
                    <p class="input_info">
                        Enter your secure website URL using (https://). This link can be a great way to promote your website, book, or other content. If you don't have a secure website, feel free to leave this field blank.
                    </p>
                    <input type="text" id="website" name="website" placeholder="Enter your Secure website URL ">
                    
                </div>

                <!-- add a youtube video link to this story -->
                <div class="form_group" id="youtubeGroup">
                    <label for="youtube">Youtube Story Link</label>
                    <!-- this link will be used to display video in the -->
                    <p class="input_info">
                        Please enter the URL of your YouTube video. This link will be used to display the video in the story's Page. If you don't have a YouTube video, feel free to leave this field blank.
                    </p>
                    <input type="text" id="youtube" name="youtube" placeholder="Enter your youtube story link">
                    
                </div>

                <!-- Add link for story background (must be from known image hosting sites) -->
                <div class="form_group" id="backgroundLink">
                    <label for="backgroundUrl">Background Image Link (Imgur, Tumblr, Flickr, Pinterest, Photobucket):</label>
                    <!-- Provide brief guidance to users -->
                    <p class="input_info">
                        For optimal performance and visual appeal, we recommend using a horizontal background image with the following specifications:
                    </p>
                    <ul>
                        <!-- URL link must end with .jpeg, .jpg, .png or .gif -->
                        <li><strong>Link Format:</strong> Must end with .jpeg, .jpg, .png or .gif</li>
                        <li><strong>Orientation:</strong> Horizontal (landscape)</li>
                        <li><strong>Recommended Size:</strong> 1200 x 630 pixels</li>
                    </ul>
                    <p class="input_info">
                        To use an image as your story background, simply copy the image link from one of the supported sites (Imgur, Tumblr, Flickr, Pinterest, Photobucket) and paste it here. Ensure the image is in a horizontal format for the best display. For detailed instructions, check our <a class="special_red_text" href="/faq#imgur" target="_blank">FAQ</a>.
                    </p>
                    <input type="text" id="backgroundUrl" name="backgroundUrl" placeholder="Enter image link - Must end with .jpeg, .jpg, .png or .gif">
                </div>


                <div class="form_group" id="storyTitleGroup">
                    <label for="storyTitle">Story Title*</label>
                    <p class="input_info">
                        Please enter your story title exactly as you would like it to appear on the site if your story is published. (max 50 characters)
                    </p>
                    <input type="text" id="storyTitle" name="storyTitle" required placeholder="Enter your story title">
                    
                </div>

                <div class="form_group" id="storySummaryGroup">
                    <label for="storySummary">Story Summary*</label>
                    <p class="input_info">
                        Please enter a brief summary of your story. This summary will be used to help readers decide whether or not to read your story, so make it as compelling as possible!
                        (max 400 characters)
                    </p>
                    <textarea id="storySummary" name="storySummary" required placeholder="Enter a summary of your story"></textarea>
                    
                </div>

                <div class="form_group" id="tagsGroup">
                    <label for="tags">Tags*</label>
                    <p class="input_info">
                        Please enter a list of tags that describe your story. These tags will be used to help readers find your story, so include relevant keywords like (haunted house, ghosts, paranormal, horror) etc.
                    </p>
                    <input type="hidden" id="tagsInput" name="tags">
                    <input type="text" id="tagsInput_fake" placeholder="Press Enter To Add Tags....">
                    <div class="tags_catagories_continer" id="tagsContainer"></div>
                </div>

                <div class="form_group" id="storyTextGroup">
                    <label for="storyText">Write Your Story*</label>
                    <textarea id="storyText" name="storyText" required placeholder="Write your story here (max 3000 W) - (. ! ?) will be used to split the story into paragraphs"></textarea>
                    
                    <p class="input_info">

                        By submitting my story via this online form, I grant <span class="special_red_text">www.terrorhub.com</span> non-exclusive rights to publish my original work. I affirm that I possess all necessary rights and have not plagiarized or borrowed content.
                    
                        <br><br>
                    
                        As the copyright holder, I retain ownership of my story. I can license it or use it as I choose. I understand that <span class="special_red_text">www.terrorhub.com</span> only claims rights to publish my story and does not own it beyond that.
                    
                        <br><br>
                    
                        I agree not to receive any compensation from <span class="special_red_text">www.terrorhub.com</span> for publishing my story. I acknowledge that I have no claim to profits from advertising or donations on the site.
                    
                        <br><br>
                    
                        If I wish to request takedown or edits, I can contact the site’s administrators directly.
                    </p>
                        
                </div>


                <div id="categoriesGroup">
                    <label id="categories_label" for="categories">Select Scary Categories:</label>
                    <div id="radio_wrap">
                        
                        <% if (popularCategories && popularCategories.length > 0) { %>
                            <h3>Popular Categories:</h3>
                            <% popularCategories.forEach(category => { %>
                                <div class="checkbox-group">
                                    <input type="checkbox" id="<%= category.replace(/\s+/g, '') %>" name="categories" value="<%= category %>" <%= story.categories && story.categories.includes(category) ? 'checked' : '' %>>
                                    <label for="<%= category.replace(/\s+/g, '') %>"><%= category %></label>
                                </div>
                            <% }); %>
                        <% } %>
                
                        <h3>Other Categories:</h3>
                        <% defaultCategories.forEach(category => { %>
                            <div class="checkbox-group">
                                <input type="checkbox" id="<%= category.replace(/\s+/g, '') %>" name="categories" value="<%= category %>" <%= story.categories && story.categories.includes(category) ? 'checked' : '' %>>
                                <label for="<%= category.replace(/\s+/g, '') %>"><%= category %></label>
                            </div>
                        <% }); %>
                    </div>
                </div>
                

                <!-- add extra tags -->
                <div class="form_group" id="extraTagsGroup">
                    <label for="extraTags">Extra Categories</label>
                    <p class="input_info">
                        Please enter any additional tags or keywords that would best describe the topics and themes your story is concerned with, in order to help us make it easier for interested readers to find your story with a keyword search.
                    </p>
                    <input type="hidden" id="extraTagsInput" name="extraTags">
                    <input type="text" id="extraTagsInput_fake" placeholder="Press Enter To Add Categories.....">
                    <div class="tags_catagories_continer" id="extraTagsContainer"></div>
                </div>
                 
                  
                <!-- Age Verification -->
                <div class="form-group legalStyles" id="ageVerificationGroup">
                    <input type="checkbox" id="ageVerification" name="ageVerification" required value="true">
                    <label for="ageVerification">I verify that I am at least 18 years old</label>
                </div>        

                <div class="form_group legalStyles" id="acceptedTermsGroup">                                          
                    <input type="checkbox" id="acceptedTerms" name="acceptedTerms" required value="true">    
                    <label for="acceptedTerms">I accept the terms and conditions</label>                            
                </div>

                <!-- i have read the terms and conditions -->
                <div class="form_group legalStyles">                    
                    <input type="checkbox" id="read_termsAndConditions" name="termsAndConditions" required value="true">
                    <label for="termsAndConditions">I have read and agree to the terms and conditions</label>
                </div>

                <div class="form_group" id="termsAndConditionsGroup_info" style="margin-top: 10px;">
                    <a href="../PDF/Terms_and_Conditions.pdf" download>Download Terms and Conditions</a>
                    <p class="input_info">
                        <span class="special_red_text">Important Note:</span> If you're under 18, please don't use this form to submit your story due to [specific reason, e.g., legal restrictions]. For more details, see our disclaimer highlighted in yellow at the page's top. Stories from individuals under 18 or those with plagiarized content will be banned, and their content will be removed.
                    </p>                   
                </div>

                <!-- You can add more fields for rating and reporting here --->
                <input type="hidden" id="csrf" name="_csrf" value="<%= csrfToken %>">
                <input id="storySubmit_form" class="call_to_action_yellow" type="submit" value="Submit">
            </form>

    </div>

    <!-- footer include -->
    <%- include('../includes/footer.ejs') %>
    
    <script src="../../JS/master.js"></script>  
    <script src="../../JS/submission.js"></script>
    <script src="../../JS/submitionUtils.js"></script>
</body>
</html>
