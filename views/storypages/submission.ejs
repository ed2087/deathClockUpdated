<!-- head include -->
<%- include('../includes/head.ejs') %>
<link rel="stylesheet" href="../../CSS/submissionPage.css">  

</head>
<body>

    <!-- nav include -->
    <%- include('../includes/nav.ejs') %>

    <!-- header include -->
    <%- include('../includes/secHeader.ejs') %>

    <div id="submisson_form_wrap">

        <!-- Enhanced title section -->
        <div id="subm_title_wrap">
            <h2>SHARE YOUR CHILLING TALE</h2>
            <p>
                Unleash your creativity and share your chilling tale with us! Whether it's a horror masterpiece, a captivating Creepypasta, or a short story that sends shivers down the spine, we welcome stories from all skill levels. Your unique perspective adds to the diverse tapestry of horror stories on our platform.
            </p>
        </div>

        <!-- Friendly content guidelines -->
        <div id="content_guidelines">
            <h3>Content Guidelines</h3>
            <p>Help us maintain a great community by avoiding:</p>
            <ul>
                <li>Content targeting or exploiting minors</li>
                <li>Content that breaks the law</li>
                <li>Hate speech or targeted harassment</li>
                <li>Sharing private information about others</li>
                <li>Impersonating real people</li>
                <li>Copying other people's work</li>
            </ul>
            <p>We welcome horror stories from writers 18+ years old. If you're younger, please have a parent or guardian contact us at <a class="link_styles" href="mailto:help.terrorhub@gmail.com">help.terrorhub@gmail.com</a>.</p>
        </div>

        <form id="submission_form">
            <input type="hidden" name="_csrf" id="csrf" value="<%= csrfToken %>">
            
            <!-- REQUIRED SECTION -->
            <div class="form_section" id="required_section">
                <h3 class="section_title">Story Basics <span class="required_indicator">*Required</span></h3>

                <!-- Legal Name (if not in profile) -->
                <% if(!legalName){ %>
                    <div class="form_group">
                        <label for="legalName">Your Legal Name *</label>
                        <input type="text" id="legalName" name="legalName" required placeholder="Enter your full name">
                        <p class="input_info">This helps us know who created the story. It won't be shared publicly.</p>
                    </div>     
                <% } else { %>  
                    <input type="hidden" id="legalName" name="legalName" value="<%= legalName %>">
                <% } %>

                <!-- Story Title -->
                <div class="form_group">
                    <label for="storyTitle">Story Title *</label>
                    <input type="text" id="storyTitle" name="storyTitle" required placeholder="What's your story called?">
                    <div class="char_counter">
                        <span id="storyTitle_count">0</span>/100 characters
                    </div>
                </div>

                <!-- Story Summary -->
                <div class="form_group">
                    <label for="storySummary">Story Summary *</label>
                    <textarea id="storySummary" name="storySummary" required placeholder="Give readers a taste of what your story is about..."></textarea>
                    <div class="char_counter">
                        <span id="storySummary_count">0</span>/800 characters
                    </div>
                    <p class="input_info">A brief teaser to get readers interested.</p>
                </div>

                <!-- Story Text -->
                <div class="form_group">
                    <label for="storyText">Your Story *</label>
                    <textarea id="storyText" name="storyText" required placeholder="Share your scary story here..."></textarea>
                    <div class="char_counter">
                        <span id="storyText_count">0</span>/40,000 characters
                    </div>
                    <p class="input_info">Let your creativity flow! You keep ownership of your story while allowing us to share it with our readers.</p>
                </div>

                <!-- Language Selection -->
                <div class="form_group">
                    <label for="language">Language *</label>
                    <select id="language" name="language" required>
                        <option value="English" selected>English</option>
                        <option value="Spanish">Spanish</option>
                        <option value="Portuguese">Portuguese</option>
                        <option value="French">French</option>
                        <option value="German">German</option>
                        <option value="Other">Other</option>
                    </select>
                    <p class="input_info">The language your story is written in.</p>
                </div>

                <!-- Primary Genre (Required) -->
                <div class="form_group">
                    <label for="primaryGenre">Primary Genre *</label>
                    <select id="primaryGenre" name="primaryGenre" required>
                        <option value="">Select the main genre...</option>
                        <option value="psychological-horror">Psychological Horror</option>
                        <option value="supernatural-horror">Supernatural Horror</option>
                        <option value="body-horror">Body Horror</option>
                        <option value="folk-horror">Folk Horror</option>
                        <option value="sci-fi-horror">Sci-Fi Horror</option>
                        <option value="slasher">Slasher</option>
                        <option value="cosmic-horror">Cosmic Horror</option>
                        <option value="gothic-horror">Gothic Horror</option>
                    </select>
                    <p class="input_info">Choose the main horror genre that best describes your story.</p>
                </div>
            </div>

            <!-- OPTIONAL SECTION (Collapsible) -->
            <div class="form_section" id="optional_section">
                <h3 class="section_title collapsible" id="optional_toggle">
                    Additional Details (Optional) 
                    <span class="toggle_icon">▼</span>
                </h3>
                
                <div class="collapsible_content" id="optional_content">
                    
                    <!-- Secondary Categories -->
                    <div class="form_group">
                        <label for="format">Format (Optional)</label>
                        <select id="format" name="format">
                            <option value="">Choose format...</option>
                            <option value="creepypasta">Creepypasta</option>
                            <option value="short-story">Short Story</option>
                            <option value="flash-fiction">Flash Fiction</option>
                            <option value="two-sentence">2 Sentence Horror</option>
                            <option value="true-story">True Story</option>
                            <option value="found-footage">Found Footage</option>
                        </select>
                    </div>

                    <div class="form_group">
                        <label for="theme">Theme (Optional)</label>
                        <select id="theme" name="theme">
                            <option value="">Choose theme...</option>
                            <option value="urban-legends">Urban Legends</option>
                            <option value="myths-legends">Myths and Legends</option>
                            <option value="ghosts">Ghosts</option>
                            <option value="monsters">Monsters</option>
                            <option value="witchcraft">Witchcraft</option>
                            <option value="technology-horror">Technology Horror</option>
                            <option value="cursed-objects">Cursed Objects</option>
                            <option value="conspiracies">Conspiracies</option>
                        </select>
                    </div>

                    <!-- Smart Tags Input -->
                    <div class="form_group">
                        <label for="tagsInput">Tags (Optional)</label>
                        <div class="smart_tags_container">
                            <input type="text" id="tagsInput" placeholder="Type to search for tags: ghost, haunted, atmospheric...">
                            <div id="tag_suggestions" class="tag_suggestions"></div>
                            <div id="selected_tags" class="selected_tags"></div>
                        </div>
                        <p class="input_info">Add keywords to help readers find your story. Start typing for suggestions.</p>
                    </div>

                    <!-- Background Image (Optional) -->
                    <div class="form_group">
                        <label for="backgroundUrl">Background Image (Optional)</label>
                        <input type="url" id="backgroundUrl" name="backgroundUrl" placeholder="Image URL from Imgur, Tumblr, Flickr, Pinterest, or Photobucket">
                        <p class="input_info">Add an atmospheric image for your story. Must end with .jpg, .png, .gif, or .webp</p>
                    </div>

                    <!-- Social Media (Simplified to 4) -->
                    <div class="form_group">
                        <label>Social Media (Optional)</label>
                        <p class="input_info">Share your profiles if you'd like readers to connect with you.</p>
                        <div class="social_media_grid">
                            <input type="url" name="facebook" placeholder="Facebook profile (optional)">
                            <input type="url" name="twitter" placeholder="Twitter profile (optional)">
                            <input type="url" name="instagram" placeholder="Instagram profile (optional)">
                            <input type="url" name="youtube" placeholder="YouTube channel (optional)">
                        </div>
                    </div>

                    <!-- YouTube Video Link -->
                    <div class="form_group">
                        <label for="youtubeVideo">YouTube Video (Optional)</label>
                        <input type="url" id="youtubeVideo" name="youtubeVideo" placeholder="YouTube video URL (optional)">
                        <p class="input_info">If you have a reading or related video, add the link here.</p>
                    </div>

                </div>
            </div>

            <!-- LEGAL SECTION -->
            <div class="form_section" id="legal_section">
                <div class="legal_checkbox">
                    <input type="checkbox" id="termsAndConditions" name="termsAndConditions" required>
                    <label for="termsAndConditions">I confirm I'm 18+ and I accept the site's terms</label>
                </div>
                
                <div class="terms_link">
                    <a href="../PDF/Terms_and_Conditions.pdf" target="_blank">View Terms and Conditions</a>
                </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" id="storySubmit_form" class="submit_button">
                <span class="submit_text">Share Your Story</span>
                <span class="submit_loading" style="display: none;">
                    <div class="lds-ellipsis"><div></div><div></div><div></div><div></div></div>
                </span>
            </button>

        </form>
    </div>

    <!-- footer include -->
    <%- include('../includes/footer.ejs') %>
    
    <script src="../../JS/master.js"></script>  
    <script src="../../JS/submission.js"></script>
</body>
</html>